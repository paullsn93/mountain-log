---
// 等高線：以固定公式產生，不依賴外部圖片
const cx = 300, cy = 260;
const paths = Array.from({ length: 15 }, (_, i) => {
  const r0 = 22 + i * 21;
  const pts: string[] = [];
  for (let a = 0; a < 360; a += 6) {
    const t = (a * Math.PI) / 180;
    const r = r0 + 9 * Math.sin(3 * t + i * 0.5) + 6 * Math.sin(5 * t - i * 0.3) + i * 1.2 * Math.cos(2 * t);
    pts.push(`${(cx + r * 1.3 * Math.cos(t)).toFixed(1)},${(cy + r * Math.sin(t)).toFixed(1)}`);
  }
  return 'M' + pts.join('L') + 'Z';
});
---
<svg viewBox="0 0 640 520" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
  {paths.map((d, i) => <path d={d} stroke-width={i % 5 === 0 ? 2 : 1} />)}
</svg>
