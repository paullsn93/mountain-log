---
import { refTypeLabels } from '../lib/difficulty';
interface Props { ids: string[]; refMap: Map<string, any>; }
const { ids, refMap } = Astro.props;
const items = ids.map((id) => refMap.get(id)).filter(Boolean);
---
{items.length === 0 ? <p class="empty">尚無參考資料。</p> : (
  <ul>
    {items.map((r) => (
      <li><span class="tag">{refTypeLabels[r.data.type as keyof typeof refTypeLabels]}</span><a href={r.data.url} target="_blank" rel="noopener">{r.data.title}</a>{r.data.note && <> — {r.data.note}</>}</li>
    ))}
  </ul>
)}
